<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TokaZerkUIConfig.App.App"
             RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Dark" Accent="#38A59D" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <StyleInclude Source="avares://TokaZerkUIManager/Design/Theme.axaml" />
  </Application.Styles>
</Application>
